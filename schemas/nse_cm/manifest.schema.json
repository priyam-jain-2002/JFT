{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jft.local/schemas/nse_cm/manifest.schema.json",
  "title": "JFT NSE CM deterministic manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_major",
    "source",
    "compressed",
    "trigger",
    "payload",
    "processing"
  ],
  "properties": {
    "schema_id": { "const": "jft.nse_cm.manifest" },
    "schema_major": { "const": 1 },
    "source": { "$ref": "#/$defs/source" },
    "compressed": { "$ref": "#/$defs/compressed_integrity" },
    "trigger": { "$ref": "#/$defs/trigger_evidence" },
    "payload": { "$ref": "#/$defs/payload_integrity" },
    "processing": { "$ref": "#/$defs/processing_identity" }
  },
  "$defs": {
    "md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_path",
        "prefix",
        "product",
        "record_kind",
        "source_date",
        "stream",
        "layout_id"
      ],
      "properties": {
        "logical_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\\\]+$"
        },
        "prefix": { "enum": ["cm", "cash"] },
        "product": { "enum": ["full", "trim"] },
        "record_kind": { "enum": ["orders", "trades"] },
        "source_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "stream": {
          "anyOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1, "maximum": 99 }
          ]
        },
        "layout_id": { "type": "string", "minLength": 1 }
      }
    },
    "compressed_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_count", "md5", "sha256"],
      "properties": {
        "byte_count": { "type": "integer", "minimum": 0 },
        "md5": { "$ref": "#/$defs/md5" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "trigger_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "declared_byte_count", "declared_md5"],
      "properties": {
        "status": {
          "enum": [
            "not_provided",
            "verified",
            "size_mismatch",
            "md5_mismatch",
            "size_and_md5_mismatch"
          ]
        },
        "declared_byte_count": {
          "anyOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "declared_md5": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/md5" }
          ]
        }
      }
    },
    "payload_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_count",
        "sha256",
        "payload_width",
        "delimiter",
        "framed_records",
        "parsed_records",
        "quarantined_records",
        "residue_bytes",
        "raw_jiffy_minimum",
        "raw_jiffy_maximum"
      ],
      "properties": {
        "byte_count": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "payload_width": { "type": "integer", "minimum": 1 },
        "delimiter": { "const": "lf" },
        "framed_records": { "type": "integer", "minimum": 0 },
        "parsed_records": { "type": "integer", "minimum": 0 },
        "quarantined_records": { "type": "integer", "minimum": 0 },
        "residue_bytes": { "type": "integer", "minimum": 0 },
        "raw_jiffy_minimum": {
          "anyOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "raw_jiffy_maximum": {
          "anyOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        }
      }
    },
    "processing_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_id", "code_identity"],
      "properties": {
        "configuration_id": { "type": "string", "minLength": 1 },
        "code_identity": { "type": "string", "minLength": 1 }
      }
    }
  }
}
